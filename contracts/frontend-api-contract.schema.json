{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-manage.local/contracts/frontend-api-contract.schema.json",
  "title": "LearningManage frontend API contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "basePath", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "basePath": { "const": "/api" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path"],
        "properties": {
          "method": { "enum": ["DELETE", "GET", "PATCH", "POST", "PUT"] },
          "path": {
            "type": "string",
            "pattern": "^/(?!api(?:/|$))[^?#]*$"
          }
        }
      }
    }
  }
}
